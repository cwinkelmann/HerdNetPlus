# HerdNet al_v9 4-experiment sweep container.
#
# 2×2 design: dataloader (old / new H-aware) × Fer-in-train (out / in).
# Same val for all 4 runs (1,123 imgs, 14 untouched non-Fern datasets).
# Sized for 80 GB GPU: BATCH=32, NUM_WORKERS=24, LR=6.4e-4.
#
# Mounts data/{fer_in,fer_out}/{train,val}/{Default,herdnet_format.csv}.

FROM pytorch/pytorch:2.4.0-cuda12.4-cudnn9-runtime

LABEL maintainer="christian.winkelmann@gmail.com"
LABEL description="HerdNet al_v9 — 2x2 dataloader × Fer sweep, post phase15 iter-7"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    LC_NUMERIC=C \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        git tini libgl1 libglib2.0-0 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml /app/
RUN pip install --upgrade pip setuptools wheel

COPY animaloc /app/animaloc/
RUN pip install -e ".[tracking]"

COPY configs /app/configs/
COPY tools   /app/tools/

# Warm-start checkpoint
COPY best_models /app/best_models/

# al_v9 datasets (both fer modes) — staged by docker/build_al_v9_sweep.sh
COPY data /app/data/

COPY docker/al_v9_sweep_entrypoint.sh /app/docker/
COPY docker/upload_model.py           /app/docker/
RUN chmod +x /app/docker/al_v9_sweep_entrypoint.sh

# Sweep defaults — 80 GB GPU.
# EXPERIMENT="all" runs A,B,C,D sequentially. Override to A|B|C|D for
# parallel use (one container per GPU).
ENV EXPERIMENT=all \
    SEED=42 \
    WANDB_PROJECT=hn_active_learning \
    WANDB_FLAG=True \
    BATCH_SIZE=32 \
    NUM_WORKERS=24 \
    AUG_MULT=10 \
    EPOCHS=30 \
    LR=6.4e-4 \
    VALIDATE_ON=f2_score \
    ADAPT_TS=0.20 \
    SCORE_THRESHOLD=0.30 \
    UPLOAD_MODEL=1

ENTRYPOINT ["/usr/bin/tini", "--", "/app/docker/al_v9_sweep_entrypoint.sh"]
